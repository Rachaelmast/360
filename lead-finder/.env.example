# PostgreSQL connection
DATABASE_URL=postgres://leadfinder:leadfinder@localhost:5432/leadfinder
# Port the API (and built web app) listens on
PORT=8787
# Set to "true" behind HTTPS so session cookies are marked Secure
COOKIE_SECURE=false
# Comma-separated extra origins allowed to call the API with a token (the extension origin is always allowed)
ALLOWED_ORIGINS=
